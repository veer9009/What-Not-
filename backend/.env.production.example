# TEMPLATE ONLY. Copy/render outside the release tree, restrict file permissions.
# Empty required fields intentionally fail validation until owner inputs exist.
WHAT_NOT_ENVIRONMENT=production
WHAT_NOT_JWT_SECRET_KEY=
DATABASE_URL=
# Set exactly ten selected identities including the operator; JSON arrays.
# Placeholder syntax only; replace privately with the full approved list:
# WHAT_NOT_BETA_ALLOWED_EMAILS='["approved-buyer@example.com","approved-seller@example.com"]'
# Do not use this two-entry illustration for admin bootstrap (ten required).
# Process environment overrides .env; editing a file does not update running settings.
# See docs/BETA_AUTHENTICATION.md before any separately authorized release.
WHAT_NOT_BETA_ALLOWED_EMAILS='[]'
WHAT_NOT_ABUSE_LIMITS_ENABLED=true
WHAT_NOT_CORS_ORIGINS='[]'
WHAT_NOT_TRUSTED_HOSTS='[]'
# Keep JSON arrays inside outer single quotes for both systemd EnvironmentFile
# and python-dotenv. For example: WHAT_NOT_TRUSTED_HOSTS='["pilot.example.test"]'
WHAT_NOT_ACCESS_TOKEN_EXPIRE_MINUTES=15
WHAT_NOT_DATABASE_POOL_SIZE=5
WHAT_NOT_DATABASE_MAX_OVERFLOW=5
WHAT_NOT_DATABASE_POOL_TIMEOUT_SECONDS=10
WHAT_NOT_DATABASE_CONNECT_TIMEOUT_SECONDS=5
# Loopback DB: postgresql+psycopg URL with explicit runtime user and database.
# Remote DB additionally requires sslmode=verify-full&sslrootcert=<approved CA>.
# URL-encode credentials; no host/user/service overrides in URL query allowed.
WHAT_NOT_EMAIL_PROVIDER=disabled
# disabled is only acceptable with explicitly approved in-app-only pilot scope.
WHAT_NOT_SMTP_STARTTLS=true
WHAT_NOT_SMTP_PORT=587
WHAT_NOT_SMTP_TIMEOUT_SECONDS=10
# SMTP enabled requires WHAT_NOT_SMTP_HOST and WHAT_NOT_EMAIL_FROM.
# Inject real SMTP credentials privately if the approved provider requires them.
WHAT_NOT_OUTBOX_BATCH_SIZE=50
WHAT_NOT_OUTBOX_LEASE_SECONDS=120
WHAT_NOT_OUTBOX_MAX_ATTEMPTS=5
WHAT_NOT_OUTBOX_BACKOFF_SECONDS=60
