# Copy to backend/.env only during initial setup; never commit credentials.
WHAT_NOT_ENVIRONMENT=development
# JSON array; use the exact origin displayed by Vite if its port changes.
WHAT_NOT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional for health/contracts; required for explicit database work and Alembic.
# Create a NEW dedicated development database; do not use manual learning databases.
# URL-encode special characters in the username/password. This is a placeholder.
# DATABASE_URL=postgresql+psycopg://whatnot_app:REPLACE_ME@127.0.0.1:5432/whatnot_app_dev
