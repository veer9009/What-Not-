# Copy to backend/.env only during initial setup; never commit credentials.
WHAT_NOT_ENVIRONMENT=development
# Required for authentication; generate securely, never commit the real key.
# WHAT_NOT_JWT_SECRET_KEY=REPLACE_ME_WITH_A_SECURE_RANDOM_KEY
WHAT_NOT_JWT_ALGORITHM=HS256
WHAT_NOT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# JSON array; use the exact origin displayed by Vite if its port changes.
WHAT_NOT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional for health/contracts; required for explicit database work and Alembic.
# Create a NEW dedicated development database; do not use manual learning databases.
# URL-encode special characters in the username/password. This is a placeholder.
# DATABASE_URL=postgresql+psycopg://whatnot_app:REPLACE_ME@127.0.0.1:5432/whatnot_app_dev

# Controlled beta: production requires a nonempty JSON allowlist and enabled quotas.
# Include trusted ADMIN operators as well as approved BUYER/SELLER accounts.
WHAT_NOT_BETA_ALLOWED_EMAILS=[]
WHAT_NOT_ABUSE_LIMITS_ENABLED=true
WHAT_NOT_AUTH_QUARTER_HOUR_LIMIT=20
WHAT_NOT_DISCOVERY_HOURLY_LIMIT=60
WHAT_NOT_ADDRESS_DAILY_LIMIT=10
WHAT_NOT_CHECKOUT_DAILY_LIMIT=20
WHAT_NOT_DELIVERY_CONFIRMATION_GRACE_HOURS=24
WHAT_NOT_PROPERTY_RECONFIRMATION_DAYS=30
WHAT_NOT_OUTBOX_BATCH_SIZE=50
WHAT_NOT_OUTBOX_LEASE_SECONDS=120
WHAT_NOT_OUTBOX_MAX_ATTEMPTS=5
WHAT_NOT_OUTBOX_BACKOFF_SECONDS=60
# disabled keeps events PENDING. Configure SMTP and verify delivery before beta.
WHAT_NOT_EMAIL_PROVIDER=disabled
# WHAT_NOT_EMAIL_FROM=orders@example.com
# WHAT_NOT_SMTP_HOST=smtp.example.com
WHAT_NOT_SMTP_PORT=587
WHAT_NOT_SMTP_STARTTLS=true
WHAT_NOT_SMTP_TIMEOUT_SECONDS=10
# WHAT_NOT_SMTP_USERNAME=REPLACE_ME
# WHAT_NOT_SMTP_PASSWORD=REPLACE_ME
